# =============================================================================
# StockSpace 环境变量模板
# =============================================================================
# 用法：cp .env.example .env  然后按需修改。
#
# 命名规则（与后端配置一致）：
#   SS_<分组>__<键>            分组与键之间是**两个下划线**
#   例如 SS_SERVER__PORT=8770 等价于 config/app.toml 的 [server] port = 8770
#
# ⚠️ 所有值都有内置默认值，**这个文件里没有一项是必填的**。留空即用默认。
# =============================================================================

# ---------------------------------------------------------------- 服务
# 直接部署(非 Docker)时后端监听的端口；Docker 部署时容器内固定 8770，
# 对外端口由 HOST_PORT 决定。
SS_SERVER__PORT=8770
SS_SERVER__HOST=0.0.0.0

# 部署在子路径（如 https://host/stock-space/）时填写前缀，否则留空。
# 注意：应用本身完全使用相对地址，因此大多数情况下留空即可，
# 由反向代理负责前缀转发。
SS_SERVER__ROOT_PATH=

# 允许跨域的来源白名单（逗号分隔）。留空 = 只允许同源（推荐）。
SS_SERVER__CORS_ORIGINS=

# 是否暴露 /docs 接口文档（生产可设为 false）
SS_SERVER__DOCS_ENABLED=true

# ---------------------------------------------------------------- 数据与配额
# 0 = 覆盖全部 A 股（约 5900 只）；小内存机器建议设为 1500 左右
SS_QUOTAS__UNIVERSE_SIZE=0
# 单轮扫描允许发起的日线网络请求上限（保护上游，避免被封禁）
SS_QUOTAS__SCAN_KLINE_BUDGET=1200
# 日线抓取并发（新浪反爬上限约 24）
SS_QUOTAS__KLINE_CONCURRENCY=16
SS_QUOTAS__QUOTE_CONCURRENCY=8
# 内存阈值（MB）：超过软上限压缩缓存，超过硬上限清空缓存
SS_QUOTAS__MEMORY_SOFT_LIMIT_MB=800
SS_QUOTAS__MEMORY_HARD_LIMIT_MB=1400
SS_QUOTAS__MEMORY_INTERVAL_SECONDS=10

# ---------------------------------------------------------------- 数据源
# auto      = 按优先级尝试真实源，全失败时明确报错（推荐）
# real      = 只用真实源，绝不降级
# synthetic = 只用内置合成行情（离线演示 / 测试；页面会显著标注"演示数据"）
SS_DATA_SOURCES__MODE=auto

# 也可以按能力覆盖上游地址（逗号分隔，第一个失败自动试下一个）：
# SS_SOURCES__EASTMONEY__URLS__SNAPSHOT=https://my-mirror/api/qt/clist/get
# SS_SOURCES__TENCENT__URLS__KLINE=https://proxy.finance.qq.com/ifzqgtimg/appstock/app/newfqkline/get

# ---------------------------------------------------------------- 调度
SS_SCHEDULER__ENABLED=true
SS_SCHEDULER__TRADING_INTERVAL_SECONDS=30
SS_SCHEDULER__IDLE_INTERVAL_SECONDS=300
# 每日任务（收盘后自动扫描 + 清理），北京时间
SS_SCHEDULER__DAILY_JOB_HOUR=15
SS_SCHEDULER__DAILY_JOB_MINUTE=10

# ---------------------------------------------------------------- 推送（企业微信）
# 推荐做法：保持这里为空，改到网页「用户配置 → 消息推送」里填写，
# 因为那里保存的内容会做掩码回显，也不会进版本库。
SS_PUSH__ENABLED=false
SS_PUSH__WECOM_WEBHOOK=
SS_PUSH__WECOM_MENTIONED_MOBILE=
SS_PUSH__SCHEDULES=09:00,11:35,15:05
SS_PUSH__MIN_SIGNAL_SCORE=75
SS_PUSH__RETRY=2

# ---------------------------------------------------------------- 资讯
SS_NEWS__ENABLED=true
# 资讯保留天数（超期自动清理）
SS_NEWS__RETENTION_DAYS=15
SS_NEWS__POLL_INTERVAL_SECONDS=120

# ---------------------------------------------------------------- 日志
SS_LOG__LEVEL=INFO

# =============================================================================
# 以下变量仅 Docker 部署使用
# =============================================================================
# 宿主机对外端口（云安全组需放行这个端口）
HOST_PORT=8770
CONTAINER_NAME=stock-space
IMAGE_NAME=stock-space
IMAGE_TAG=latest
TZ=Asia/Shanghai

# 是否把可选数据源（AKShare / Ashare）一起装进镜像。
# 注意：会显著增加镜像体积与构建时间，按需开启。
INSTALL_OPTIONAL=false

# 国内镜像加速（构建慢时可替换）
PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
PIP_EXTRA_INDEX_URL=https://pypi.mirrors.ustc.edu.cn/simple

# 启用 with-nginx profile 时的对外端口
NGINX_PORT=80
